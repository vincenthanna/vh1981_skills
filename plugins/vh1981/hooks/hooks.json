{
  "description": "vh1981 plugin hooks — injects the default guidelines, keeps the devlog status line installed, and checks the checkout in to the knowledge base",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/inject-guidelines.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/check-statusline.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/kb-checkin.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
